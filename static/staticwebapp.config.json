{
  "auth": {
    "rolesSource": "/api/GetRoles",
    "identityProviders": {
      "customOpenIdConnectProviders": {
        "google": {
          "registration": {
            "clientIdSettingName": "GOOGLE_CLIENT_ID",
            "clientCredential": { "clientSecretSettingName": "GOOGLE_CLIENT_SECRET" },
            "openIdConnectConfiguration": {
              "wellKnownOpenIdConfiguration": "https://accounts.google.com/.well-known/openid-configuration"
            }
          },
          "login": { "nameClaimType": "email", "scopes": ["openid", "profile", "email"] }
        }
      }
    }
  },
  "platform": { "apiRuntime": "python:3.11" },
  "routes": [
     { "route": "/.auth/*", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/login", "redirect": "/.auth/login/google?post_login_redirect_uri=/" },
    {
      "route": "/logout",
      "redirect": "/.auth/logout?post_logout_redirect_uri=/home.html",
      "headers": { "Clear-Site-Data": "\"cache\"" }
    },
    { "route": "/api/GetRoles", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/denied.html", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/privacy.html", "allowedRoles": ["anonymous", "authenticated"] },
    { "route": "/home.html", "allowedRoles": ["anonymous", "authenticated"] },

    { "route": "/valheim", "rewrite": "/valheim.html", "allowedRoles": ["valheim"] },
    { "route": "/valheim.html", "allowedRoles": ["valheim"] },
    { "route": "/api/valheim/*", "allowedRoles": ["valheim"] },

    { "route": "/media/*", "allowedRoles": ["family"],
      "headers": { "Cache-Control": "private, max-age=86400" } },
    { "route": "/*", "allowedRoles": ["family"] }
  ],
  "responseOverrides": {
    "401": { "rewrite": "/home.html", "statusCode": 401 },
    "403": { "statusCode": 302, "redirect": "/denied.html" }
  },
  "globalHeaders": {
    "X-Robots-Tag": "noindex, nofollow",
    "Cache-Control": "no-cache"
  }
}